  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "smoke": "playwright test",
    "smoke:local": "node scripts/check-local-model.mjs",
    "package": "npm run prepare:windows && npm run build && electron-builder --win nsis --x64 --arm64",
    "prepare:windows": "node scripts/prepare-windows-native.mjs",
    "assets": "node scripts/create-placeholders.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "electron-store": "^11.0.2",
    "fflate": "^0.8.3",
    "gifuct-js": "^2.1.2",
    "highlight.js": "^11.12.0",
    "koffi": "^3.3.2",
    "marked": "^18.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "upng-js": "^2.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/cousine": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/upng-js": "^2.1.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tar": "^7.5.22",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
